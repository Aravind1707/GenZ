# GenZ OS LAN server — MySQL runs on the admin PC
GENZ_DB_HOST=127.0.0.1
GENZ_DB_PORT=3306
GENZ_DB_NAME=genz_os
GENZ_DB_USER=genz_app
GENZ_DB_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
GENZ_DB_POOL_SIZE=10

# Never expose these values with NEXT_PUBLIC_.
# Customer/admin browsers must never receive database credentials.
