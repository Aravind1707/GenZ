# GenZ OS production environment template
# Copy to .env and replace EVERY CHANGE_ME value before deployment.
# Never commit .env or production secrets.

# =========================
# DATABASE
# =========================
GENZ_DB_HOST=127.0.0.1
GENZ_DB_PORT=3306
GENZ_DB_NAME=genz_os
GENZ_DB_USER=genz_app
GENZ_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
GENZ_DB_POOL_SIZE=10
MYSQL_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_ROOT_PASSWORD

# =========================
# PUBLIC APPLICATION URL
# =========================
GENZ_PUBLIC_BASE_URL=https://order.example.com
GENZ_TRUST_PROXY=false
GENZ_OWNER_REMOTE_ACCESS_ENABLED=false
GENZ_OWNER_REMOTE_ACCESS_MODE=VPN

# =========================
# SESSION SECURITY — SERVER SIDE ONLY
# =========================
GENZ_SESSION_SIGNING_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SIGNING_SECRET

# =========================
# CUSTOMER OTP — SERVER SIDE ONLY
# =========================
GENZ_OTP_MSG91_AUTHKEY=CHANGE_ME_MSG91_AUTHKEY
GENZ_OTP_MSG91_SENDER_ID=CHANGE_ME_APPROVED_SENDER_ID
GENZ_OTP_DEV_MODE=false

# =========================
# RAZORPAY — SERVER SIDE ONLY
# =========================
GENZ_RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
GENZ_RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_SECRET
GENZ_RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_RAZORPAY_WEBHOOK_SECRET

# =========================
# OPTIONAL POS/ECR — KEEP DISABLED UNTIL VERIFIED
# =========================
GENZ_POS_PROVIDER=NONE
GENZ_POS_INTEGRATION_ENABLED=false
GENZ_POS_DYNAMIC_UPI_QR_ENABLED=false
GENZ_POS_CARD_ENABLED=false
GENZ_POS_AUTO_CONFIRM_ENABLED=false

# =========================
# INITIAL OWNER BOOTSTRAP
# Used only while staff_users is empty.
# Use a unique high-entropy password and rotate/clear bootstrap config after setup.
# =========================
GENZ_STAFF_INITIAL_USERNAME=owner
GENZ_STAFF_INITIAL_NAME=Owner
GENZ_STAFF_INITIAL_PASSWORD=CHANGE_ME_LONG_RANDOM_INITIAL_PASSWORD

# =========================
# STATION AGENTS
# Use unique strong secrets per station. Do not reuse one secret everywhere.
# Example JSON: {"STATION-01":"...","STATION-02":"..."}
# =========================
GENZ_STATION_AGENT_SECRETS_JSON={}

# =========================
# STARTUP
# =========================
GENZ_RUN_MIGRATIONS=true
GENZ_APP_PORT=3000
