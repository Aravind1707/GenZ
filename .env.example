# GenZ OS LAN server — MySQL runs on the admin PC
GENZ_DB_HOST=127.0.0.1
GENZ_DB_PORT=3306
GENZ_DB_NAME=genz_os
GENZ_DB_USER=genz_app
GENZ_DB_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
GENZ_DB_POOL_SIZE=10

# Customer OTP — server-side only
GENZ_OTP_MSG91_AUTHKEY=CHANGE_THIS_TO_MSG91_AUTHKEY
GENZ_OTP_MSG91_SENDER_ID=CHANGE_THIS_TO_APPROVED_SENDER_ID
GENZ_OTP_DEV_MODE=false

# Razorpay — NEVER expose the secret to the browser
GENZ_RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
GENZ_RAZORPAY_KEY_SECRET=CHANGE_THIS_TO_RAZORPAY_SECRET
GENZ_RAZORPAY_WEBHOOK_SECRET=CHANGE_THIS_TO_WEBHOOK_SECRET

# Staff bootstrap — used ONLY when staff_users is empty; choose a strong password
GENZ_STAFF_INITIAL_USERNAME=owner
GENZ_STAFF_INITIAL_NAME=Owner
GENZ_STAFF_INITIAL_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
