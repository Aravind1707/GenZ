# GenZ OS LAN server — MySQL runs on the admin PC
GENZ_DB_HOST=127.0.0.1
GENZ_DB_PORT=3306
GENZ_DB_NAME=genz_os
GENZ_DB_USER=genz_app
GENZ_DB_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
GENZ_DB_POOL_SIZE=10

# Customer OTP — keep these server-side; NEVER use NEXT_PUBLIC_.
# MSG91 OTP credentials are configured in the admin PC environment.
GENZ_OTP_MSG91_AUTHKEY=CHANGE_THIS_TO_MSG91_AUTHKEY
GENZ_OTP_MSG91_SENDER_ID=CHANGE_THIS_TO_APPROVED_SENDER_ID
# Development only: set true to return the generated OTP to the local dev UI.
# NEVER enable this in production.
GENZ_OTP_DEV_MODE=false

# Customer/admin browsers must never receive database or SMS-provider credentials.
