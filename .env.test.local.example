# Local-only staging overrides. Copy to .env.test.local and never commit the copy.
# Razorpay Test Mode only. The application refuses non-test keys in the smoke harness.
GENZ_RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
GENZ_RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_TEST_SECRET
GENZ_RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_RAZORPAY_WEBHOOK_SECRET
